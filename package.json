    "@astrojs/sitemap": "^3.7.4",
    "@lucide/astro": "^1.72.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.11",
    "marked": "^17.0.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-external-links": "^3.0.0",
    "satori": "^0.35.2",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1",
    "tailwindcss": "^4.3.5"
