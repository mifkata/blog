    "@storybook/react": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "eslint-mdx": "^3.9.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-mdx": "^3.9.5",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^0.14.1",
    "storybook": "^10.6.7",
