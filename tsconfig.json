{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*", ".storybook/**/*"],
  "exclude": [
    "dist",
    "node_modules",
    "worktrees",
    ".worktrees",
    "storybook-static"
  ],
  "compilerOptions": {
    "strictNullChecks": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  }
}
