---
import Callout from "@/components/prose/Callout.astro";
import {
  calloutType,
  type CalloutType,
  type HighlightColor,
} from "@/components/prose/callout";

interface Props {
  color?: HighlightColor;
  /** A callout instead of a highlighted phrase */
  block?: boolean;
  /** For blocks; otherwise read from the colour */
  type?: CalloutType;
}

const { color = "yellow", block = false, type } = Astro.props;

const colorClasses = {
  yellow: "bg-yellow-200/60 dark:bg-yellow-500/30",
  green: "bg-green-200/60 dark:bg-green-500/30",
  blue: "bg-blue-200/60 dark:bg-blue-500/30",
  pink: "bg-pink-200/60 dark:bg-pink-500/30",
};
---

{
  block ? (
    <Callout type={calloutType(type, color)}>
      <slot />
    </Callout>
  ) : (
    <mark class:list={["px-1 rounded-sm", colorClasses[color]]}>
      <slot />
    </mark>
  )
}
