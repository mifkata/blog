---
import GitHub from "@/components/ui/icons/GitHub.astro";
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";

interface Props {
  name: string;
  external?: boolean;
  archived?: boolean;
}

const { name, external = false, archived = false } = Astro.props;

const url = external
  ? "https://code.claude.com/docs/en/slash-commands"
  : archived
    ? `https://github.com/mifkata/blog/blob/main/public/archive/commands/${name}.md`
    : `https://github.com/mifkata/blog/blob/main/.claude/commands/${name}.md`;

const title = external
  ? `View the official documentation for the /${name} command on Claude's website`
  : `View the source for the /${name} command on GitHub`;
---

<a
  href={url}
  target="_blank"
  rel="noopener noreferrer"
  title={title}
  class="command"
>
  {external ? <LucideIcon icon="globe" size={13} /> : <GitHub size={13} />}
  /{name}
  <span class="sr-only">(opens in new tab)</span>
</a>

<style>
  /* A pill that sits on the text's baseline */
  .command {
    display: inline-flex;
    align-items: center;
    gap: 0.3em;
    padding: 0.04em 0.55em 0.04em 0.45em;
    border-radius: 999px;
    background: color-mix(in srgb, var(--palette-accent) 11%, transparent);
    color: var(--palette-accent-strong);
    font:
      600 0.82em ui-monospace,
      "SF Mono",
      Menlo,
      Consolas,
      monospace;
    text-decoration: none;
    vertical-align: 0.06em;
    white-space: nowrap;
    transition: background-color 0.2s;
  }
  .command:hover {
    background: color-mix(in srgb, var(--palette-accent) 20%, transparent);
    color: var(--palette-accent-strong);
  }
</style>
