---
import GitHub from "@/components/ui/icons/GitHub.astro";
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import Wikipedia from "@/components/ui/icons/Wikipedia.astro";
import { compactNumber, shownStars, type PostLink } from "@/helpers/postLinks";

interface Props {
  link: PostLink & { stars?: number };
}

const { link } = Astro.props;
const stars = shownStars(link);
---

<a
  href={link.url}
  title={link.url}
  target={link.own ? undefined : "_blank"}
  rel={link.own ? undefined : "noopener noreferrer nofollow"}
  class:list={{ profile: link.kind === "github-profile" }}
>
  {link.own && <img src="/icons/favicon.svg" width="14" height="14" alt="" />}
  {
    !link.own && (link.kind === "github" || link.kind === "github-profile") && (
      <GitHub size={14} />
    )
  }
  {link.kind === "wikipedia" && <Wikipedia size={14} />}
  {
    (link.kind === "npm" || link.kind === "web") && (
      <LucideIcon icon={link.kind === "npm" ? "package" : "globe"} size={14} />
    )
  }
  <span class="name">{link.label}</span>
  {
    stars !== undefined && (
      <span class="stars" title={`${stars} stars on GitHub`}>
        <LucideIcon icon="star" size={12} />
        {compactNumber(stars)}
      </span>
    )
  }
  {!link.own && <span class="sr-only">(opens in new tab)</span>}
</a>

<style>
  a {
    display: grid;
    grid-template-columns: 14px minmax(0, 1fr) auto;
    gap: 8px;
    align-items: center;
    color: var(--palette-text);
    text-decoration: none;
  }
  a:hover {
    color: var(--palette-accent);
  }
  a > :global(svg:first-child) {
    color: var(--palette-muted);
  }
  a.profile > :global(svg:first-child) {
    color: var(--palette-accent);
  }
  img {
    display: block;
    border-radius: 3px;
  }
  .name {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .stars {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    color: var(--palette-muted);
    font-size: 0.78rem;
    font-variant-numeric: tabular-nums;
  }
</style>
