---
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import { getSeriesWithPosts } from "@/helpers/series";

interface Props {
  slug: string;
  current?: string;
  open?: boolean;
}

const { slug, current, open = false } = Astro.props;
const { items, title } = await getSeriesWithPosts(slug);
const index = items.findIndex(
  ({ id, url }) => current === url || current === id,
);
---

{
  items.length > 0 && (
    <details class="series" open={open}>
      <summary>
        <span class="series-head">
          <span class="series-kicker">
            Series{index !== -1 && ` · part ${index + 1} of ${items.length}`}
          </span>
          <span class="series-title">{title}</span>
        </span>
        <span class="series-dots" aria-hidden="true">
          {items.map((_, i) => (
            <i class:list={{ "is-current": i === index }} />
          ))}
        </span>
        <span class="series-more">
          All parts
          <LucideIcon icon="chevron-down" size={14} />
        </span>
      </summary>
      <ol>
        {items.map(({ url, title }, i) =>
          i === index ? (
            <li class="is-current" aria-current="page">
              {title}
            </li>
          ) : (
            <li>
              <a href={url}>{title}</a>
            </li>
          ),
        )}
      </ol>
    </details>
  )
}

<style>
  .series {
    margin: 0 0 var(--prose-gap, 1.5rem);
    padding: 12px 14px 12px 16px;
    border: 1px solid var(--palette-line);
    border-radius: 12px;
    background: var(--palette-surface);
    font-size: 1rem;
    line-height: 1.5;
  }
  summary {
    display: flex;
    align-items: center;
    gap: 12px;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .series-head {
    display: grid;
    flex: 1;
    gap: 2px;
    min-width: 0;
  }
  .series-kicker {
    color: var(--palette-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .series-title {
    color: var(--palette-heading);
    font:
      700 1.05rem/1.25 "Zilla Slab",
      Rockwell,
      Georgia,
      serif;
  }
  .series-dots {
    display: inline-flex;
    gap: 4px;
  }
  .series-dots i {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--palette-line);
  }
  .series-dots i.is-current {
    background: var(--palette-accent);
  }
  .series-more {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--palette-accent);
    font-size: 0.8125rem;
    white-space: nowrap;
  }
  .series-more :global(svg) {
    transition: transform 0.2s;
  }
  .series[open] .series-more :global(svg) {
    transform: rotate(180deg);
  }
  ol {
    display: grid;
    gap: 6px;
    margin: 12px 0 0;
    padding: 12px 0 2px;
    border-top: 1px solid var(--palette-line);
    list-style: none;
    counter-reset: part;
  }
  li {
    display: flex;
    gap: 10px;
    counter-increment: part;
  }
  li::before {
    content: counter(part);
    width: 1em;
    color: var(--palette-muted);
    font-variant-numeric: tabular-nums;
  }
  li.is-current {
    color: var(--palette-heading);
  }
  li.is-current::before {
    color: var(--palette-accent);
  }
  li a {
    color: var(--palette-text);
    text-decoration: none;
  }
  li a:hover {
    color: var(--palette-accent);
  }

  @media (max-width: 479px) {
    .series-dots {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .series-more :global(svg) {
      transition: none;
    }
  }
</style>
