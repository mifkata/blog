---
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import TocList from "./TocList.astro";
import type { TocChapter } from "./toc";

interface Props {
  outline: TocChapter[];
  readingMinutes?: number;
}

const { outline, readingMinutes } = Astro.props;
---

<nav class="toc" aria-label="On this page">
  <div class="toc-head">
    <span>On this page</span>
    {
      readingMinutes && (
        <span class="toc-left" data-toc-left={readingMinutes}>
          {readingMinutes} min left
        </span>
      )
    }
  </div>
  <div class="toc-progress" data-toc-progress></div>
  <TocList outline={outline} />
  <button type="button" class="toc-top" data-toc-top>
    <LucideIcon icon="arrow-up" size={14} />
    Back to top
  </button>
</nav>

<style>
  /* Sticks under the shrunk header: the 40px status bar and the 4px
     chapter line */
  .toc {
    position: sticky;
    top: calc(44px + 1.5rem);
    max-height: calc(100vh - 44px - 3rem);
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 16px 18px 14px;
    border: 1px solid var(--palette-line);
    border-radius: 14px;
    background: var(--palette-surface);
    box-shadow: 0 18px 40px -28px rgb(0 0 0 / 0.35);
  }
  .toc-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    margin-bottom: 10px;
    color: var(--palette-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .toc-left {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0;
    text-transform: none;
  }
  .toc-progress {
    height: 2px;
    margin-bottom: 12px;
    border-radius: 2px;
    background:
      linear-gradient(var(--palette-accent), var(--palette-accent)) 0 0 /
        calc(var(--progress, 0) * 100%) 100% no-repeat,
      var(--palette-line);
  }
  .toc-top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
    padding: 0;
    border: 0;
    background: none;
    color: var(--palette-muted);
    font: inherit;
    font-size: 0.8125rem;
    cursor: pointer;
  }
  .toc-top:hover {
    color: var(--palette-accent);
  }
</style>
