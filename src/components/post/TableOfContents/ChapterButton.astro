---
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import TocList from "./TocList.astro";
import type { TocChapter } from "./toc";

interface Props {
  outline: TocChapter[];
}

const { outline } = Astro.props;
---

<!-- The current chapter in the status bar, like a tmux window title -->
<div class="chapter">
  <button
    type="button"
    class="chapter-button"
    aria-expanded="false"
    aria-controls="chapter-menu"
    data-chapter-toggle
  >
    <span class="chapter-number" data-chapter-number>§ 1/{outline.length}</span>
    <span class="chapter-title" data-chapter-title>{outline[0].text}</span>
    <LucideIcon icon="chevron-down" size={14} />
  </button>
  <nav
    id="chapter-menu"
    class="chapter-menu"
    aria-label="Chapters"
    hidden
    data-chapter-menu
  >
    <TocList outline={outline} />
  </nav>
</div>

<style>
  .chapter {
    position: relative;
    display: flex;
    min-width: 0;
  }
  .chapter-button {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    max-width: 460px;
    padding: 4px 8px;
    border: 0;
    border-radius: 3px;
    background: rgb(255 255 255 / 0.07);
    color: var(--palette-terminal-text);
    font: inherit;
    cursor: pointer;
  }
  .chapter-button:hover {
    background: rgb(255 255 255 / 0.12);
  }
  .chapter-button:focus-visible {
    outline: 2px solid var(--palette-terminal-prompt);
    outline-offset: 1px;
  }
  .chapter-number {
    flex: none;
    color: var(--palette-terminal-prompt);
  }
  .chapter-title {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chapter-button :global(svg) {
    flex: none;
    transition: transform 0.2s;
  }
  .chapter-button[aria-expanded="true"] :global(svg) {
    transform: rotate(180deg);
  }
  .chapter-menu {
    position: absolute;
    top: calc(100% + 12px);
    left: 0;
    z-index: 10;
    width: min(400px, calc(100vw - 2 * var(--page-gutter)));
    max-height: calc(100vh - 120px);
    overflow-y: auto;
    padding: 14px 16px;
    border: 1px solid var(--palette-line);
    border-radius: 12px;
    background: var(--palette-surface);
    box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.4);
    font:
      1rem/1.4 "Kedebideri",
      sans-serif;
    white-space: normal;
  }
  .chapter-menu[hidden] {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .chapter-button :global(svg) {
      transition: none;
    }
  }
</style>
