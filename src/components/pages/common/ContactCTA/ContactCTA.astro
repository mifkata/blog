---
import Button from "@/components/ui/Button/Button.astro";
import LinkedIn from "@/components/ui/icons/LinkedIn.astro";
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import { LINKEDIN_URL } from "@/consts";

interface Props {
  headline?: string;
  description?: string;
  buttonText?: string;
  buttonHref?: string;
  linkedinText?: string;
  linkedinHref?: string;
  /** Just the text and buttons, left-aligned, for a section that already has
   * its own heading */
  inline?: boolean;
}

const {
  headline = "Wanna connect?",
  description = "Feel invited to send me a message any time. My door is wide open to making new connections!",
  buttonText = "Send me an email",
  buttonHref = "mailto:hi@mifkata.com",
  linkedinText = "Check me out on LinkedIn",
  linkedinHref = LINKEDIN_URL,
  inline = false,
} = Astro.props;

const Wrapper = inline ? "div" : "section";
---

<Wrapper
  class={inline ? undefined : "text-center py-12 border-t border-gray-light"}
>
  {!inline && <p class="text-xl text-gray mb-2">{headline}</p>}
  <p class="text-gray-dark mb-6">
    {description}
    {Astro.slots.has("default") && " "}
    <slot />
  </p>
  <!-- Equal-width buttons: widest one sets the width, stacked on mobile -->
  <div class="inline-grid gap-4 sm:grid-flow-col sm:auto-cols-fr">
    <Button
      href={buttonHref}
      class="px-6 py-3 justify-center border border-transparent bg-origin-border"
      variant="inverse"
    >
      <LucideIcon slot="icon" icon="mail" size={18} />
      {buttonText}
    </Button>
    {
      linkedinHref && (
        <Button
          href={linkedinHref}
          target="_blank"
          rel="noopener noreferrer"
          class="px-6 py-3 justify-center"
          variant="ghost"
        >
          <LinkedIn slot="icon" size={18} />
          {linkedinText}
          <span class="sr-only">(opens in new tab)</span>
        </Button>
      )
    }
  </div>
</Wrapper>
