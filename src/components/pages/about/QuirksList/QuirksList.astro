---
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";

interface Props {
  quirks: string[];
}

const { quirks } = Astro.props;
---

<ul class="grid gap-3 md:grid-cols-2 md:gap-x-12">
  {
    quirks.map((quirk) => (
      <li class="flex items-start gap-3 text-gray-dark">
        <span class="mt-1.5 text-button">
          <LucideIcon icon="circle" size={12} />
        </span>
        {quirk}
      </li>
    ))
  }
</ul>
