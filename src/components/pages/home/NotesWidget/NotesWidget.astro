---
import RailDots from "@/components/ui/RailDots/RailDots.astro";
import { isoDay } from "@/helpers/notes";

export interface WidgetNote {
  id: string;
  title: string;
  date: Date;
  /** The note as plain text, shown in place of the title on hover */
  text: string;
}

interface Props {
  notes: WidgetNote[];
}

const { notes } = Astro.props;

const shortDate = (date: Date) =>
  date.toLocaleDateString("en-us", {
    month: "short",
    day: "2-digit",
    timeZone: "UTC",
  });
---

{
  notes.length > 0 && (
    <section data-series-rail aria-labelledby="notes-title">
      <header class="flex flex-wrap items-end justify-between gap-x-6 gap-y-1 mb-6">
        <div class="min-w-0">
          <p class="text-sm text-accent uppercase tracking-wider m-0 mb-2">
            Mental notes
          </p>
          <h2 id="notes-title" class="text-3xl m-0 text-black">
            Random brain dump
          </h2>
        </div>
        <a
          href="/notes/"
          class="text-accent hover:text-accent-dark no-underline text-sm text-nowrap"
        >
          All notes →
        </a>
      </header>

      <ul class="note-cards" data-rail-track>
        {notes.map((note) => (
          <li data-rail-card>
            <a href={`/notes/#${note.id}`} class="note-card">
              <span class="note-stack">
                <span class="note-title">{note.title}</span>
                <span class="note-text">{note.text}</span>
              </span>
              <span class="note-foot">
                <time class="note-date" datetime={isoDay(note.date)}>
                  {shortDate(note.date)}
                </time>
                <svg
                  class="note-arrow"
                  aria-hidden="true"
                  width="28"
                  height="28"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.4"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M3 12h17M14 6l6 6-6 6" />
                </svg>
              </span>
            </a>
          </li>
        ))}
      </ul>
      <RailDots count={notes.length} label="note" class="mt-2 sm:hidden" />
    </section>
  )
}

<style>
  @property --note-orbit {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  /* Phones scroll the cards sideways, the next one peeking in; the padding
     and negative margin leave room for focus outlines the scroller would
     clip */
  .note-cards {
    position: relative;
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 80%;
    gap: 14px;
    margin: -4px;
    padding: 4px;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-padding-inline: 4px;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    list-style: none;
  }
  .note-cards::-webkit-scrollbar {
    display: none;
  }
  .note-cards > li {
    min-width: 0;
    scroll-snap-align: start;
  }

  /* The title gives way to the note on hover, and the border lights up the
     way the accent buttons do: a band of current and a circling spark */
  .note-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 20px;
    box-sizing: border-box;
    height: 100%;
    min-height: 200px;
    padding: 20px 22px;
    border: 1px solid var(--palette-trace-mid);
    border-radius: 8px;
    background: var(--palette-surface);
    color: var(--palette-text);
    text-decoration: none;
    transition: background-color 0.25s;
  }
  .note-card:is(:hover, :focus-visible) {
    background: var(--palette-hero);
  }
  .note-card:focus-visible {
    outline: 2px solid var(--palette-accent);
    outline-offset: 2px;
  }

  .note-card::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 35%,
      color-mix(in srgb, var(--palette-accent) 12%, transparent) 46%,
      color-mix(in srgb, var(--palette-accent) 32%, transparent) 50%,
      color-mix(in srgb, var(--palette-accent) 12%, transparent) 54%,
      transparent 65%
    );
    translate: -110% 0;
    pointer-events: none;
  }
  .note-card:is(:hover, :focus-visible)::before {
    animation: note-sweep 0.75s cubic-bezier(0.25, 0.6, 0.2, 1) both;
  }

  .note-card::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--note-orbit),
      transparent 0 72%,
      var(--palette-accent) 88%,
      var(--palette-accent-strong) 91%,
      transparent 93%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .note-card:is(:hover, :focus-visible)::after {
    opacity: 1;
    animation: note-orbit 1.3s linear infinite;
  }

  /* Both sit in one cell, so the card is as tall as the longer of the two */
  .note-stack {
    display: grid;
  }
  .note-stack > * {
    grid-area: 1 / 1;
    transition: opacity 0.25s;
  }
  .note-title {
    color: var(--palette-heading);
    font-family: "Zilla Slab", Rockwell, Georgia, serif;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.25;
  }
  .note-text {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 6;
    font-size: 1rem;
    line-height: 1.55;
    opacity: 0;
  }
  .note-card:is(:hover, :focus-visible) .note-text {
    opacity: 1;
  }
  .note-card:is(:hover, :focus-visible) .note-title {
    opacity: 0;
  }

  .note-foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
  }
  .note-date {
    color: var(--palette-muted);
    font:
      0.8125rem/1.9 ui-monospace,
      "SF Mono",
      Menlo,
      Consolas,
      monospace;
  }
  .note-arrow {
    color: var(--palette-accent);
    transition: translate 0.25s;
  }
  .note-card:is(:hover, :focus-visible) .note-arrow {
    translate: 4px 0;
  }

  /* Without hover there's nothing to reveal on, so show both */
  @media (hover: none) {
    .note-stack {
      display: block;
    }
    .note-text {
      margin-top: 8px;
      opacity: 1;
      -webkit-line-clamp: 4;
    }
    /* A tap leaves the card in :hover until the next tap elsewhere; it must
       not swap the title away or light up the border */
    .note-card:hover:not(:focus-visible) {
      background: var(--palette-surface);
    }
    .note-card:hover:not(:focus-visible)::before,
    .note-card:hover:not(:focus-visible)::after {
      animation: none;
    }
    .note-card:hover:not(:focus-visible)::after {
      opacity: 0;
    }
    .note-card:hover:not(:focus-visible) .note-title {
      opacity: 1;
    }
    .note-card:hover:not(:focus-visible) .note-arrow {
      translate: none;
    }
  }

  @media (min-width: 640px) {
    .note-cards {
      grid-auto-flow: row;
      grid-auto-columns: auto;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin: 0;
      padding: 0;
      overflow: visible;
      scroll-snap-type: none;
    }
  }
  @media (min-width: 960px) {
    .note-cards {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @keyframes note-sweep {
    from {
      translate: -110% 0;
    }
    to {
      translate: 110% 0;
    }
  }
  @keyframes note-orbit {
    to {
      --note-orbit: 360deg;
    }
  }

  /* Reduced motion: no sweep, and the spark holds still */
  @media (prefers-reduced-motion: reduce) {
    .note-card:is(:hover, :focus-visible)::before,
    .note-card:is(:hover, :focus-visible)::after {
      animation: none;
    }
  }
</style>

<script>
  // The same rail as the featured series: it tracks the scroll for the dots
  // and lets a cut-off card scroll into view before it opens
  import { setupSeriesRails } from "@/components/pages/home/FeaturedSeries/rail";

  setupSeriesRails();
  document.addEventListener("astro:page-load", setupSeriesRails);
</script>
