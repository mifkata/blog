---
interface Props {
  command?: string;
  output?: string;
}

const {
  command = "cat life_as_we_know_it.note",
  output = "Family man. Forever learning. Iterating on everything (this line is on v7). Motorcycles to clear the cache.",
} = Astro.props;
---

<section class="max-w-[960px] mx-auto pb-12 mt-8">
  <div class="bg-terminal text-terminal-text p-4 rounded-lg font-mono text-sm">
    <span class="text-terminal-prompt">$</span>
    <span class="text-terminal-text ml-2">{command}</span>
    <div class="mt-2 text-terminal-text opacity-80">
      {`> ${output}`}
    </div>
  </div>
</section>
