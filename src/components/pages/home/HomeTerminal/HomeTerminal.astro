---
interface Props {
  command?: string;
  output?: string;
}

const {
  command = "cat life_right_now.note",
  output = "@ $HOME | working 24/7 | free time is family time. Squeezing tokens out of ALL subscriptions. Building software factories, control planes and code graphs. Too cold for motorcycles...",
} = Astro.props;
---

<section class="pb-12 mt-8">
  <div class="bg-terminal text-terminal-text p-4 rounded-lg font-mono text-sm">
    <span class="text-terminal-prompt">$</span>
    <span class="text-terminal-text ml-2">{command}</span>
    <div class="mt-2 text-terminal-text opacity-80">
      {`> ${output}`}
    </div>
  </div>
</section>
