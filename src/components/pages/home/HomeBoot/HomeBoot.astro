---
/**
 * Terminal welcome that plays over the home hero copy (see boot.ts). It sits
 * on top of the real copy, which stays in the page for readers and search
 * engines and keeps its space, so nothing shifts when the boot ends.
 */
---

<div class="boot" aria-hidden="true" data-boot-screen>
  <div class="boot-lines" data-boot-lines></div>
  <p class="boot-logo" hidden data-boot-logo>
    <span class="boot-bracket">&lt;</span><span data-boot-letters></span><span
      class="boot-bracket boot-close">/&gt;</span
    >
  </p>
</div>

<style>
  .boot {
    display: none;
    position: absolute;
    inset: 0;
    z-index: 1;
    align-content: start;
    pointer-events: none;
  }

  :global(html[data-boot]) .boot {
    display: grid;
  }

  .boot-lines {
    font:
      clamp(0.8rem, 3.4vw, 1rem) / 1.75 ui-monospace,
      "SF Mono",
      Menlo,
      Consolas,
      monospace;
    color: var(--palette-text);
  }

  .boot-lines :global(.boot-line) {
    margin: 0;
  }

  .boot-lines :global(.boot-prompt),
  .boot-lines :global(.boot-ok) {
    color: var(--palette-accent);
    font-weight: 700;
  }

  .boot :global(.boot-caret) {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    margin-left: 0.05em;
    vertical-align: text-bottom;
    background: var(--palette-accent);
    animation: boot-blink 0.5s steps(1) infinite;
  }

  .boot-logo {
    display: inline-flex;
    align-items: baseline;
    justify-self: start;
    margin: 0.35em 0 0;
    font:
      700 clamp(2.6rem, 7vw, 4.25rem) / 1.1 "Zilla Slab",
      Rockwell,
      Georgia,
      serif;
    color: var(--palette-heading);
  }

  .boot-logo[hidden] {
    display: none;
  }

  .boot-logo :global(.boot-caret) {
    width: 0.45em;
    height: 0.1em;
    vertical-align: baseline;
  }

  .boot-bracket {
    color: var(--palette-accent);
  }

  .boot-close {
    margin-left: 0.18em;
  }

  .boot-logo:not(.is-typed) .boot-close {
    visibility: hidden;
  }

  @keyframes boot-blink {
    0%,
    49% {
      opacity: 1;
    }
    50%,
    100% {
      opacity: 0;
    }
  }
</style>

<style is:global>
  /* The tag flying from the hero into the header (see boot.ts). */
  ::view-transition-group(site-logo) {
    animation-duration: var(--boot-morph, 0.6s);
    animation-timing-function: cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  ::view-transition-old(root),
  ::view-transition-new(root) {
    animation-duration: 0.45s;
  }
</style>

<script>
  import { runBoot } from "./boot";

  runBoot();
</script>
