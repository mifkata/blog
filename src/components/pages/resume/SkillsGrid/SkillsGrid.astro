---
import Badge from "@/components/ui/Badge.astro";
import LucideIcon, {
  type IconName,
} from "@/components/ui/icons/LucideIcon.astro";

interface Skill {
  name: string;
  icon: IconName;
  items: string[];
}

interface Props {
  skills: Skill[];
}

const { skills } = Astro.props;
---

<div class="grid grid-cols-2 md:grid-cols-3 gap-6">
  {
    skills.map((skill) => (
      <div>
        <span class="text-sm text-gray uppercase tracking-wider mb-3 font-normal flex items-center gap-2">
          <LucideIcon icon={skill.icon} size={16} class="text-[#6FA4AF]" />
          {skill.name}
        </span>
        <div class="flex flex-wrap gap-2">
          {skill.items.map((item) => (
            <Badge>{item}</Badge>
          ))}
        </div>
      </div>
    ))
  }
</div>
