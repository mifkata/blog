---
import { Image } from "astro:assets";
import FormattedDate from "@/components/ui/FormattedDate/FormattedDate.astro";
import { Markdown } from "@/components/post/Markdown/Markdown";
import Tag from "@/components/ui/Tag/Tag.astro";
import type { LabPost } from "./fixtures";

interface Props {
  posts: LabPost[];
  title?: string;
}

const { posts, title = "All Posts" } = Astro.props;
---

<section>
  <div class="flex items-center gap-3 mb-8">
    <h3 class="text-lg m-0 text-gray uppercase tracking-wider">{title}</h3>
    <div class="flex-1 h-px bg-gray-light"></div>
  </div>
  <div class="space-y-10">
    {
      posts.map((post) => (
        <article class="group grid md:grid-cols-[200px_1fr] gap-6 items-start">
          <a
            href={`/blog/${post.id}/`}
            tabindex="-1"
            aria-hidden="true"
            class="block"
          >
            <Image
              src={post.data.heroImage}
              alt=""
              width={640}
              height={384}
              class="rounded-lg w-full h-auto object-cover group-hover:shadow-lg transition-shadow"
            />
          </a>
          <div>
            <a href={`/blog/${post.id}/`} class="no-underline">
              <h4 class="text-2xl m-0 mb-2 text-black group-hover:text-accent transition-colors">
                {post.data.title}
              </h4>
            </a>
            <Markdown
              text={post.data.synopsis || post.data.description}
              className="text-gray mb-3 [&_p]:m-0 [&_p+p]:mt-3 [&_strong]:text-gray-dark [&_a]:underline"
            />
            <div class="flex items-center gap-4 text-sm text-gray">
              <FormattedDate date={post.data.pubDate} />
              <div class="hidden md:flex gap-2">
                {post.data.tags.map((tag) => (
                  <Tag tag={tag} class="text-xs" />
                ))}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
