---
import { Image } from "astro:assets";
import FormattedDate from "@/components/ui/FormattedDate/FormattedDate.astro";
import { Markdown } from "@/components/post/Markdown/Markdown";
import Tag from "@/components/ui/Tag/Tag.astro";
import type { LabPost } from "./fixtures";

interface Props {
  posts: LabPost[];
  title?: string;
}

const { posts, title = "All Posts" } = Astro.props;
---

<section>
  <div class="flex items-center gap-3 mb-8">
    <h3 class="text-lg m-0 text-gray uppercase tracking-wider">{title}</h3>
    <div class="flex-1 h-px bg-gray-light"></div>
  </div>
  <div class="space-y-12">
    {
      posts.map((post) => (
        <article class="group">
          <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1 mb-4">
            <a href={`/blog/${post.id}/`} class="no-underline">
              <h4 class="text-2xl m-0 text-black group-hover:text-accent transition-colors">
                {post.data.title}
              </h4>
            </a>
            <span class="text-sm text-gray">
              <FormattedDate date={post.data.pubDate} />
            </span>
          </div>
          <div class="grid md:grid-cols-[200px_1fr] gap-6 items-start">
            <a
              href={`/blog/${post.id}/`}
              tabindex="-1"
              aria-hidden="true"
              class="block"
            >
              <Image
                src={post.data.heroImage}
                alt=""
                width={640}
                height={384}
                class="rounded-lg w-full h-auto object-cover"
              />
            </a>
            <div>
              <Markdown
                text={post.data.synopsis || post.data.description}
                className="rounded-r-lg border-l-2 border-accent bg-surface px-5 py-4 mb-3 text-gray-dark [&_p]:m-0 [&_p+p]:mt-3 [&_a]:underline"
              />
              <div class="flex flex-wrap gap-1.5">
                {post.data.tags.map((tag) => (
                  <Tag tag={tag} class="text-xs" />
                ))}
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>
