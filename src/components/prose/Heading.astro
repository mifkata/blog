---
import type { HTMLAttributes } from "astro/types";

type Props = HTMLAttributes<"h2"> & { as: "h2" | "h3" | "h4" };

const { as: Tag, class: className, ...rest } = Astro.props;
---

<Tag class:list={["heading", className]} {...rest}><slot /></Tag>

<style>
  .heading {
    color: var(--palette-heading);
    font-family: "Zilla Slab", Rockwell, Georgia, serif;
    font-weight: 700;
    letter-spacing: normal;
    text-wrap: balance;
  }
  /* A hairline above each section */
  h2.heading {
    margin: 2.1em 0 0.55em;
    padding-top: 0.75em;
    border-top: 1px solid var(--palette-line);
    font-size: 1.75em;
    line-height: 1.18;
  }
  h3.heading {
    margin: 1.7em 0 0.45em;
    padding-left: 0.7em;
    border-left: 3px solid var(--palette-accent);
    font-size: 1.3em;
    line-height: 1.25;
  }
  h4.heading {
    margin: 1.5em 0 0.4em;
    font-size: 1.08em;
    line-height: 1.3;
  }
</style>
