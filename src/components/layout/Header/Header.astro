---
import SiteLogo from "@/components/layout/SiteLogo/SiteLogo.astro";
import TmuxBar from "./TmuxBar.astro";
---

<!-- The slot keeps the expanded header height in the layout while the header
     shrinks, so shrinking never shifts the page (and never triggers scroll
     anchoring, which used to bounce the header back and forth). -->
<div id="site-header-slot" class="sticky top-0 z-50 w-full pointer-events-none">
  <header
    id="site-header"
    class="pointer-events-auto bg-surface shadow-sm w-full"
  >
    <div class="header-top" data-header-top>
      <div class="header-top-inner">
        <div class="px-(--page-gutter) py-2">
          <div class="max-w-(--page-column) mx-auto">
            <h1 id="site-header-logo" class="text-2xl mt-2 whitespace-nowrap">
              <SiteLogo />
            </h1>
          </div>
        </div>
      </div>
    </div>
    <TmuxBar />
  </header>
</div>

<style>
  /* Scrolling collapses the logo row, leaving the status bar as the header */
  .header-top {
    display: grid;
    grid-template-rows: 1fr;
    transition: grid-template-rows 0.3s ease;
  }
  .header-top-inner {
    min-height: 0;
    overflow: hidden;
  }
  #site-header.is-shrunk .header-top {
    grid-template-rows: 0fr;
  }
  #site-header.is-measuring,
  #site-header.is-measuring :global(*) {
    transition: none !important;
  }
  @media (prefers-reduced-motion: reduce) {
    .header-top {
      transition: none;
    }
  }
</style>

<script>
  function setupHeaderScroll() {
    const slot = document.getElementById("site-header-slot");
    const header = document.getElementById("site-header");
    const top = header?.querySelector<HTMLElement>("[data-header-top]");
    if (!slot || !header || !top || header.dataset.scrollReady) return;
    header.dataset.scrollReady = "true";

    const SHRINK_AT = 40;
    const EXPAND_AT = 10;
    let scrolled = false;
    let ticking = false;

    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // Pin the slot to the header's expanded height. Measured with transitions
    // off, then the previous state is restored, so any shrink/expand
    // animation still runs afterwards.
    function lockSlotHeight() {
      const wasShrunk = header!.classList.contains("is-shrunk");
      header!.classList.add("is-measuring");
      header!.classList.remove("is-shrunk");
      slot!.style.height = "";
      const height = slot!.getBoundingClientRect().height;
      header!.classList.toggle("is-shrunk", wasShrunk);
      void header!.offsetHeight;
      header!.classList.remove("is-measuring");
      slot!.style.height = `${height}px`;
    }

    function applyState() {
      if (scrolled) {
        lockSlotHeight();
        header!.classList.add("is-shrunk");
      } else {
        header!.classList.remove("is-shrunk");
        if (reducedMotion.matches) slot!.style.height = "";
      }
    }

    // Once fully expanded again, let the slot follow the header.
    top.addEventListener("transitionend", (event) => {
      if (!scrolled && event.propertyName === "grid-template-rows") {
        slot.style.height = "";
      }
    });

    function update() {
      if (!scrolled && window.scrollY > SHRINK_AT) {
        scrolled = true;
        applyState();
      } else if (scrolled && window.scrollY < EXPAND_AT) {
        scrolled = false;
        applyState();
      }
      ticking = false;
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", () => {
      if (scrolled) lockSlotHeight();
    });
  }
  setupHeaderScroll();
  document.addEventListener("astro:page-load", setupHeaderScroll);
</script>
