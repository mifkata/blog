---
import GitHub from "@/components/ui/icons/GitHub.astro";
import LinkedIn from "@/components/ui/icons/LinkedIn.astro";
import { LINKEDIN_URL } from "@/consts";

const today = new Date();
const lastUpdated = today.toISOString().split("T")[0];
const commitSha = import.meta.env.CF_PAGES_COMMIT_SHA?.slice(0, 7);
const reboot = "reboot?";
---

<footer
  class="p-12 md:px-6 xl:px-26 text-sm text-gray-dark bg-gradient-to-t from-gray-dark/10 via-transparent to-transparent border-t border-gray-light/50"
>
  <div
    class="mx-auto grid md:text-left md:grid-cols-[1fr_1fr_auto] gap-4 text-center items-start"
  >
    <!-- Left: Copyright & Contacts -->
    <div class="space-y-1">
      <p class="m-0 md:whitespace-nowrap">
        👨‍💻 &copy; {today.getFullYear()} Andriyan Ivanov
      </p>
      <p class="m-0">
        🧭 Holistic Product Generalist · AI adoption and engineering
      </p>
      <p class="m-0 italic mt-2">
        💭 "The problem with the world is that the intelligent people are full
        of doubts, while the stupid ones are full of confidence." - Charles
        Bukowski
      </p>
    </div>
    <!-- Middle: Info -->
    <div class="space-y-1">
      <p class="m-0">
        🏷️ <a href="/tags" class="hover:text-accent">Tags</a> · <a
          href="/sitemap-index.xml"
          class="hover:text-accent">Sitemap</a
        > · <a href="/rss.xml" class="hover:text-accent">RSS</a> · <a
          href="https://github.com/mifkata/blog"
          class="hover:text-accent">Source</a
        >
      </p>
      <p
        class="m-0 flex items-center justify-center md:justify-start gap-2 md:whitespace-nowrap"
      >
        ✉️ <a href="mailto:hi@mifkata.com" class="hover:text-accent"
          >hi@mifkata.com</a
        >
        <a
          href="https://github.com/mifkata"
          class="hover:text-accent"
          aria-label="GitHub"
        >
          <GitHub size={20} />
        </a>
        <a href={LINKEDIN_URL} class="hover:text-accent" aria-label="LinkedIn">
          <LinkedIn size={20} />
        </a>
      </p>
      <p class="m-0 md:whitespace-nowrap p-0">
        🚀 Last updated: {lastUpdated} · Built with <a
          href="https://astro.build"
          class="hover:text-accent">Astro</a
        >{commitSha && ` · Commit ${commitSha}`}
      </p>
      <p class="m-0 md:whitespace-nowrap">
        🔥 Footer reached? Respect!<span class="md:hidden"
          >{" · "}<a href="/?boot" class="hover:text-accent"
            >Reboot the welcome</a
          ></span
        >
      </p>
    </div>
    <!-- Cat -->
    <div class="hidden md:grid justify-items-start gap-1">
      <a
        href="/?boot"
        class="cat-bubble"
        aria-label="Replay the welcome"
        title="Replay the welcome"
      >
        <svg class="cat-bubble-shape" viewBox="0 0 96 46" aria-hidden="true">
          <path
            d="M13 1H83A12 12 0 0 1 95 13V23A12 12 0 0 1 83 35H38L22 45L28 35H13A12 12 0 0 1 1 23V13A12 12 0 0 1 13 1Z"
          ></path>
        </svg>
        <span class="cat-bubble-label">
          <span class="cat-bubble-word">
            {
              [...reboot].map((letter, i) => (
                <span style={`--i: ${i}`}>{letter}</span>
              ))
            }
          </span>
        </span>
      </a>
      <pre
        class="cat-ascii font-mono text-xs leading-none m-0 text-gray">{`
 /\\_/\\
( o.o )
 > ^ <`}</pre>
    </div>
  </div>
</footer>

<style>
  .cat-bubble {
    position: relative;
    display: block;
    width: 6rem;
    color: var(--palette-accent);
    text-decoration: none;
  }

  .cat-bubble:hover {
    color: var(--palette-accent);
  }

  .cat-bubble-shape {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .cat-bubble-shape path {
    fill: var(--palette-surface);
    stroke: var(--palette-trace-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
    transition:
      fill 0.25s ease,
      stroke 0.25s ease;
  }

  .cat-bubble:is(:hover, :focus-visible) path {
    fill: color-mix(in srgb, var(--palette-accent) 8%, var(--palette-surface));
    stroke: var(--palette-accent);
  }

  .cat-bubble:focus-visible {
    outline: none;
  }

  .cat-bubble-label {
    position: absolute;
    inset: 0 0 auto;
    height: calc(100% * 35 / 46);
    display: flex;
    align-items: center;
    justify-content: center;
    font:
      0.8125rem / 1 ui-monospace,
      "SF Mono",
      Menlo,
      Consolas,
      monospace;
  }

  .cat-bubble-word {
    display: inline-flex;
    height: 1.2em;
    line-height: 1.2em;
    overflow: hidden;
  }

  .cat-bubble-word span {
    display: inline-block;
    text-shadow: 0 1.2em var(--palette-accent-strong);
    transition: translate 0.35s cubic-bezier(0.65, 0, 0.25, 1)
      calc(var(--i) * 30ms);
  }

  .cat-bubble:is(:hover, :focus-visible) .cat-bubble-word span {
    translate: 0 -1.2em;
  }

  /* Lines the cat's head (3.5 characters in) up under the bubble's tail tip
     (x 22 of the 96-wide shape). */
  .cat-ascii {
    padding: 0;
    margin-left: calc(6rem * 22 / 96 - 3.5ch);
  }

  @media (prefers-reduced-motion: reduce) {
    .cat-bubble-word span,
    .cat-bubble-shape path {
      transition: none;
    }
  }
</style>
