---
import { COPY } from "./copy";
---

<div
  class="absolute inset-x-4 bottom-4 mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-x-6 gap-y-3 rounded-[10px] bg-terminal ring-1 ring-terminal-text/20 px-4 py-3 font-mono text-sm leading-normal text-terminal-text shadow-lg"
>
  <p class="m-0! min-w-0 flex-1 basis-64 leading-normal! text-terminal-text">
    {COPY}
  </p>
  <div class="flex flex-none gap-2">
    <button
      type="button"
      class="cursor-pointer rounded-[3px] border-0 bg-terminal-prompt px-3 py-1.5 font-bold text-terminal focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terminal-prompt"
    >
      Accept
    </button>
    <button
      type="button"
      class="cursor-pointer rounded-[3px] border border-terminal-text bg-transparent px-3 py-1.5 text-terminal-text focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-terminal-prompt"
    >
      Decline
    </button>
  </div>
</div>
