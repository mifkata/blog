---
interface Props {
  href?: string;
  variant?: "normal" | "inverse" | "ghost";
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = "normal", class: className, target, rel } = Astro.props;

const baseStyles =
  "inline-flex items-center gap-2 px-4 py-2 rounded no-underline transition-all duration-200 ease-out";
const variantStyles = {
  normal:
    "bg-button-light !text-button border border-button hover:brightness-95 hover:-translate-y-0.5 hover:shadow-md",
  inverse: "bg-gradient-to-br from-button-hi to-button-lo !text-button-text",
  ghost:
    "bg-transparent !text-button border border-button hover:bg-button-light/50",
};

// Hover animation (hexField.ts): a honeycomb ripples out from the pointer on
// the filled button and converges on it on the outlined one.
const hex = {
  normal: undefined,
  inverse: { wave: "out", tone: "light" },
  ghost: { wave: "in", tone: "accent" },
}[variant];

const classes = [
  baseStyles,
  variantStyles[variant],
  hex && `hex-button hex-button--${hex.tone}`,
  className,
];
const Element = href ? "a" : "button";
---

<Element
  href={href}
  target={target}
  rel={rel}
  class:list={classes}
  data-hex={hex?.wave}
>
  <slot />
</Element>

<style>
  @property --hex-button-orbit {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .hex-button {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  /* Hexagons start pushed away from the pointer (converging) or towards it. */
  .hex-button[data-hex="in"] {
    --push: 6px;
  }

  .hex-button[data-hex="out"] {
    --push: -6px;
  }

  .hex-button--light {
    --band: var(--palette-button-glint);
    --band-soft: var(--palette-button-glint-soft);
    --hex-line: var(--palette-button-hex);
    --hex-fill: var(--palette-button-hex-fill);
    --hex-flash: var(--palette-button-hex-flash);
    --spark: var(--palette-button-spark);
    --spark-head: var(--palette-button-spark-head);
  }

  .hex-button--accent {
    --band: color-mix(in srgb, var(--palette-accent) 32%, transparent);
    --band-soft: color-mix(in srgb, var(--palette-accent) 12%, transparent);
    --hex-line: color-mix(in srgb, var(--palette-outline) 42%, transparent);
    --hex-fill: color-mix(in srgb, var(--palette-outline) 4%, transparent);
    --hex-flash: color-mix(in srgb, var(--palette-outline) 35%, transparent);
    --spark: var(--palette-accent);
    --spark-head: var(--palette-accent-strong);
  }

  /* The flash: a band of current that wipes the honeycomb away. */
  .hex-button::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 35%,
      var(--band-soft) 46%,
      var(--band) 50%,
      var(--band-soft) 54%,
      transparent 65%
    );
    translate: -110% 0;
    pointer-events: none;
  }

  /* Duration and easing are mirrored in hexField.ts to time each hexagon. */
  .hex-button.is-waving::before {
    animation: hex-button-sweep var(--sweep) cubic-bezier(0.25, 0.6, 0.2, 1)
      var(--clear-at) both;
  }

  /* The spark that circles the border once the flash has passed. */
  .hex-button::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--hex-button-orbit),
      transparent 0 72%,
      var(--spark) 88%,
      var(--spark-head) 91%,
      transparent 93%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .hex-button.is-charged::after {
    opacity: 1;
    transition-delay: var(--spark-at);
    animation: hex-button-orbit 1.3s linear var(--spark-at) infinite;
  }

  /* The honeycomb is generated by script, so it carries no scoped attribute. */
  .hex-button :global(.hex-field) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
  }

  .hex-button :global(.hex) {
    fill: var(--hex-fill);
    stroke: var(--hex-line);
    stroke-width: 0.8;
    opacity: 0;
    transform-box: fill-box;
    transform-origin: center;
  }

  /* One shot per hover: pop in along the wave, then flare and vanish as the flash passes. */
  .hex-button.is-waving :global(.hex) {
    animation:
      hex-button-in 0.3s cubic-bezier(0.3, 1.4, 0.5, 1) var(--in) both,
      hex-button-out 0.16s ease-out var(--out) forwards;
  }

  @keyframes hex-button-in {
    from {
      opacity: 0;
      scale: 0.35;
      translate: calc(var(--ux) * var(--push)) calc(var(--uy) * var(--push));
      fill: var(--hex-flash);
    }
    to {
      opacity: 1;
      scale: 1;
      translate: 0 0;
      fill: var(--hex-fill);
    }
  }

  @keyframes hex-button-out {
    0% {
      opacity: 1;
      scale: 1;
      fill: var(--hex-fill);
    }
    30% {
      opacity: 1;
      scale: 1.05;
      fill: var(--hex-flash);
    }
    100% {
      opacity: 0;
      scale: 0.6;
      fill: var(--hex-flash);
    }
  }

  @keyframes hex-button-sweep {
    from {
      translate: -110% 0;
    }
    to {
      translate: 110% 0;
    }
  }

  @keyframes hex-button-orbit {
    to {
      --hex-button-orbit: 360deg;
    }
  }

  /* Reduced motion: no honeycomb or flash, and the spark holds still. */
  @media (prefers-reduced-motion: reduce) {
    .hex-button.is-charged::after {
      animation: none;
    }
  }
</style>

<script>
  import { setupHexButtons } from "./hexField";

  setupHexButtons();
  document.addEventListener("astro:page-load", setupHexButtons);
</script>
