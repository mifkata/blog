---
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";

interface Props {
  href?: string;
  variant?: "normal" | "inverse" | "ghost";
  class?: string;
  target?: string;
  rel?: string;
}

const { href, variant = "normal", class: className, target, rel } = Astro.props;

const baseStyles =
  "inline-flex items-center gap-2 px-4 py-2 rounded no-underline transition-all duration-200 ease-out";
const variantStyles = {
  normal:
    "bg-button-light !text-button border border-button hover:brightness-95 hover:-translate-y-0.5 hover:shadow-md",
  inverse: "bg-gradient-to-br from-button-hi to-button-lo !text-button-text",
  ghost:
    "bg-transparent !text-button border border-button hover:bg-button-light/50",
};

// Hover: a band of current sweeps through the button and a spark circles its
// outline, in light tones on the filled button and the accent on the outlined
// one
const surge = { normal: undefined, inverse: "light", ghost: "accent" }[variant];

// A button without its own icon gets a bulb; either way, the icon lights up
const hasIcon = Astro.slots.has("icon");

const classes = [
  baseStyles,
  variantStyles[variant],
  surge && `surge surge--${surge}`,
  className,
];
const Element = href ? "a" : "button";
---

<Element href={href} target={target} rel={rel} class:list={classes}>
  <span
    class:list={["button-icon", { "is-bulb": !hasIcon }]}
    aria-hidden="true"
  >
    {hasIcon ? <slot name="icon" /> : <LucideIcon icon="bulb" size={18} />}
  </span>
  <slot />
</Element>

<style>
  @property --surge-orbit {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }

  .surge {
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }

  .surge--light {
    --band: var(--palette-button-glint);
    --band-soft: var(--palette-button-glint-soft);
    --spark: var(--palette-button-spark);
    --spark-head: var(--palette-button-spark-head);
    /* Lamp light: the sparks here are dark in some palettes, for contrast */
    --icon-light: #fff3c2;
  }

  .surge--accent {
    --band: color-mix(in srgb, var(--palette-accent) 32%, transparent);
    --band-soft: color-mix(in srgb, var(--palette-accent) 12%, transparent);
    --spark: var(--palette-accent);
    --spark-head: var(--palette-accent-strong);
    /* In light mode the same lamp light as the filled button; in dark mode
       the button's own colour, lightened. An accent halo clashes with both */
    --icon-light: #fff3c2;
  }

  @media (prefers-color-scheme: dark) {
    .surge--accent {
      --icon-light: color-mix(in oklch, var(--palette-button-hi) 65%, white);
    }
  }

  /* The band of current, parked off to the left until hover */
  .surge::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      100deg,
      transparent 35%,
      var(--band-soft) 46%,
      var(--band) 50%,
      var(--band-soft) 54%,
      transparent 65%
    );
    translate: -110% 0;
    pointer-events: none;
  }

  .surge:is(:hover, :focus-visible)::before {
    animation: surge-sweep 0.75s cubic-bezier(0.25, 0.6, 0.2, 1) both;
  }

  /* The spark that circles the outline while hovered */
  .surge::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 2px;
    background: conic-gradient(
      from var(--surge-orbit),
      transparent 0 72%,
      var(--spark) 88%,
      var(--spark-head) 91%,
      transparent 93%
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }

  .surge:is(:hover, :focus-visible)::after {
    opacity: 1;
    animation: surge-orbit 1.3s linear infinite;
  }

  /* The icon, dimmed at rest and lit while hovered: the bulb's glass fills
     with light, any other icon glows */
  .button-icon {
    display: inline-flex;
    flex: none;
    opacity: 0.8;
    transition:
      opacity 0.3s ease,
      filter 0.3s ease;
  }

  .button-icon :global(svg) {
    transition: fill-opacity 0.3s ease;
  }

  /* The bulb's glass fills with the lamp light, not the text colour */
  .button-icon.is-bulb :global(svg) {
    fill: var(--icon-light, currentColor);
    fill-opacity: 0;
  }

  :is(a, button):is(:hover, :focus-visible) > .button-icon {
    opacity: 1;
    filter: drop-shadow(0 0 2px var(--icon-light, currentColor))
      drop-shadow(0 0 6px var(--icon-light, currentColor));
  }

  :is(a, button):is(:hover, :focus-visible)
    > .button-icon.is-bulb
    :global(svg) {
    fill-opacity: 0.9;
  }

  @keyframes surge-sweep {
    from {
      translate: -110% 0;
    }
    to {
      translate: 110% 0;
    }
  }

  @keyframes surge-orbit {
    to {
      --surge-orbit: 360deg;
    }
  }

  /* Reduced motion: no sweep, and the spark holds still; the icon still
     lights up */
  @media (prefers-reduced-motion: reduce) {
    .surge:is(:hover, :focus-visible)::before,
    .surge:is(:hover, :focus-visible)::after {
      animation: none;
    }
  }
</style>
