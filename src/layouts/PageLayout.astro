---
import BaseHead from "@/components/layout/BaseHead/BaseHead.astro";
import Header from "@/components/layout/Header/Header.astro";
import Footer from "@/components/layout/Footer/Footer.astro";
import type { TocChapter } from "@/components/post/TableOfContents/toc";

interface Props {
  title: string;
  description: string;
  /** The social card to share this page with; the home page's by default */
  card?: string;
  class?: string;
  /** A post's chapters, shown in the header's status bar */
  outline?: TocChapter[];
}

const { title, description, card, class: className, outline } = Astro.props;
---

<html lang="en">
  <head>
    <BaseHead title={title} description={description} card={card} />
  </head>
  <body>
    <div class="content-wrapper">
      <Header outline={outline} />
      <main
        class:list={[
          "w-full max-w-[calc(var(--page-column)+2*var(--page-gutter))] mx-auto px-(--page-gutter) py-12",
          className,
        ]}
      >
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
