---
import { getCollection } from "astro:content";
import { isPublished } from "@/helpers/content/posts";
import { activityMonths, summarizeTags } from "@/helpers/content/tags";
import PageLayout from "@/layouts/PageLayout.astro";
import PageHeader from "@/components/pages/common/PageHeader/PageHeader.astro";
import TagCloud from "@/components/pages/tags/TagCloud/TagCloud.astro";
import TagsTimeline from "@/components/pages/tags/TagsTimeline/TagsTimeline.astro";
import { SITE_TITLE } from "@/consts.data";
import tagsData from "@/data/tags.json";

const posts = await getCollection("blog", isPublished);
const now = new Date();
const tags = summarizeTags(
  posts.map((post) => ({
    id: post.id,
    title: post.data.title,
    date: post.data.pubDate,
    tags: post.data.tags,
  })),
  tagsData,
  now,
);
const cloud = [...tags].sort((a, b) => a.slug.localeCompare(b.slug));
---

<PageLayout title={`Tags | ${SITE_TITLE}`} description="Browse posts by tag">
  <section>
    <PageHeader
      title="Tags"
      subtitle="What the blog has been writing about. Bigger tags have more posts; dots show posts per month over the last year."
      class="mb-8"
    />
    <TagCloud
      tags={cloud}
      label="Tags by number of posts"
      size="lg"
      showCounts
      class="mb-10 rounded-xl bg-hero p-5 md:p-7"
    />
    <TagsTimeline tags={tags} months={activityMonths(now)} />
  </section>
</PageLayout>
