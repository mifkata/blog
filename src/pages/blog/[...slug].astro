---
import { type CollectionEntry, getCollection, render } from "astro:content";
import { discussions, withStars } from "@/helpers/linkActivity";
import { extractLinks } from "@/helpers/postLinks";
import { isPublished } from "@/helpers/posts";
import { readingMinutes } from "@/helpers/reading";
import { seriesForPost } from "@/helpers/series";
import { seriesPosition } from "@/helpers/seriesPosition";
import BlogPostLayout from "@/layouts/BlogPostLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog", isPublished);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, allPosts: posts },
  }));
}

interface Props {
  post: CollectionEntry<"blog">;
  allPosts: CollectionEntry<"blog">[];
}

const { post, allPosts } = Astro.props;
const { Content, headings } = await render(post);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const links = extractLinks(post.body ?? "");
const [linksWithStars, stories, seriesParts] = await Promise.all([
  withStars(links),
  discussions(links),
  seriesForPost(post.id),
]);

const currentTags = post.data.tags || [];
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .map((p) => {
    const matchingTags = (p.data.tags || []).filter((tag) =>
      currentTags.includes(tag),
    );
    return { post: p, matchCount: matchingTags.length };
  })
  .filter((p) => p.matchCount > 0)
  .sort((a, b) => b.matchCount - a.matchCount)
  .map((p) => p.post);
---

<BlogPostLayout
  {...post.data}
  headings={tocHeadings}
  relatedPosts={relatedPosts}
  readingMinutes={readingMinutes(post.body ?? "")}
  series={seriesPosition(post.id)}
  seriesParts={seriesParts}
  links={linksWithStars}
  stories={stories}
  filePath={post.filePath}
>
  <Content />
</BlogPostLayout>
