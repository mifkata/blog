---
import Button from "@/components/ui/Button/Button.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import AboutHero from "@/components/pages/about/AboutHero/AboutHero.astro";
import AboutSection from "@/components/pages/about/AboutSection/AboutSection.astro";
import QuirksList from "@/components/pages/about/QuirksList/QuirksList.astro";
import ContactCTA from "@/components/pages/common/ContactCTA/ContactCTA.astro";
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import { SITE_TITLE } from "@/consts";

const quirks = [
  "I read multiple books at the same time and finish them unpredictably.",
  "I talk to my dog as if he's a rational adult, because he basically is.",
  "I hate small talk but can talk for hours about motorcycles, psychology, or why a line of code is ugly.",
  "I don't watch much new media; I rewatch the same favourite shows like comfort rituals.",
  "When I travel, I plan only one day ahead and leave the rest open to discovery.",
  "One person can be brilliant. A crowd mostly makes sure nobody stands out.",
  "I read the documentation. All of it. Sometimes twice. Thank the universe for AI summaries.",
  "I give honest feedback, but only when asked. Unsolicited advice is rude.",
  "I cook with love and twist every recipe until it's mine. Like chasing a good idea, getting a dish right is mostly about timing.",
  "I count the number 19 with my fingers constantly, for no good reason.",
];
---

<PageLayout
  title={`About | ${SITE_TITLE}`}
  card="about"
  description="Born in Varna, Bulgaria. Started working at 17. Holistic Product Generalist with 25+ years of building products, focused on AI adoption and engineering."
>
  <AboutHero />

  <AboutSection title="Outside of Work">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="clock" size={22} /></span
    >
    <p class="text-gray-dark mb-4">
      My world is made of books, motorcycles, travel, cooking, music, my family
      and my dog. The last two I'd gladly die for.
    </p>
    <p class="text-gray-dark">
      I get obsessive about learning; even after 25+ years in the industry, I
      still compare myself to the best in the field and feel like I'm far
      behind. Coffee in the morning is non-negotiable. Everything else can fall
      apart.
    </p>
  </AboutSection>

  <AboutSection title="Values">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="heart" size={22} /></span
    >
    <p class="text-gray-dark">
      I value intelligence and kindness, and I try to bring both to the people I
      work with. I believe in freedom: to try new ideas, to question old ones,
      and to change my mind when the facts change. I lead with creativity,
      looking for the unexpected solution and refining it until it looks
      obvious.
    </p>
  </AboutSection>

  <AboutSection title="How People See Me">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="users" size={22} /></span
    >
    <p class="text-gray-dark">
      One face, no hidden settings, and no second opinion for when you leave the
      room. I try to be as clear as possible. Curious people love that; people
      who enjoy office politics find it a bit inconvenient. I can live with
      that.
    </p>
  </AboutSection>

  <AboutSection title="Right Now">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="info" size={22} /></span
    >
    <p class="text-gray-dark">
      I'm learning languages, going to the gym, and pushing myself through
      university because I want to teach someday. Maybe that's my way of giving
      back, or maybe I just like making things harder than they need to be.
    </p>
  </AboutSection>

  <AboutSection
    title="Quirks"
    note="Because everyone has them, mine are just louder"
  >
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="star" size={22} /></span
    >
    <QuirksList quirks={quirks} />
  </AboutSection>

  <AboutSection title="Let's talk" class="mb-12">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="message-square" size={22} /></span
    >
    <ContactCTA inline />
  </AboutSection>
</PageLayout>
