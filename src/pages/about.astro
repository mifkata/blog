---
import Button from "@/components/ui/Button/Button.astro";
import PageLayout from "@/layouts/PageLayout.astro";
import AboutHero from "@/components/pages/about/AboutHero/AboutHero.astro";
import AboutSection from "@/components/pages/about/AboutSection/AboutSection.astro";
import QuirksList from "@/components/pages/about/QuirksList/QuirksList.astro";
import ContactCTA from "@/components/pages/common/ContactCTA/ContactCTA.astro";
import LucideIcon from "@/components/ui/icons/LucideIcon.astro";
import { SITE_TITLE } from "@/consts";

const quirks = [
  "I read multiple books at the same time and finish them unpredictably.",
  "I talk to my dog as if he's a rational adult, because he basically is.",
  "I hate small talk but can talk for hours about motorcycles, psychology, or why a line of code is ugly (and why the agent failed to make it pretty).",
  "I don't watch many new movies and TV shows, but I religiously rewatch old ones. I have watched TBBT at least 10 times.",
  "When I travel, I book at most 3 days ahead and I read about the places I visit after I have visited them.",
  "I feel that crowds make people dumber rather than smarter. The smartest person in the room always applies.",
  "I devour documentation like Cookie Monster devours cookies. Now with the help of AI summarisation, I get to devour even more.",
  "I avoid giving my opinion without being asked, unless I'm rudely provoked - normal human stuff.",
  "Since I learned how to cook, I only browse cooking recipes as a reference, at most to make sure I'm not missing a key ingredient. Nothing beats cooking with your heart!",
  "Since I was a little kid, if I'm not on the keyboard, I keep counting the number 19 with the tips of my fingers or with my toes. I always thought 19 is an important number in my life. I'm yet to find out why.",
];
---

<PageLayout
  title={`About | ${SITE_TITLE}`}
  card="about"
  description="Bulgarian-born hardcore software engineer with a passion for product excellence and state-of-the-art software architecture design."
>
  <AboutHero />

  <AboutSection title="Outside of Work">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="clock" size={22} /></span
    >
    <p class="text-gray-dark mb-4">
      My world is made of books, motorcycles, travel, cooking, music, my family
      and my dog. The last two I'd gladly die for.
    </p>
    <p class="text-gray-dark">
      I'm obsessed with learning and adopting new skills in any area of life.
      One of my philosophies is "the more you learn, the less you know". My
      favourite drinks are coffee and beer and I do my best to never mix them
      together.
    </p>
  </AboutSection>

  <AboutSection title="Values">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="heart" size={22} /></span
    >
    <p class="text-gray-dark">
      I value intelligence and kindness, one or the other. When people are kind,
      they make me want to be kind as well. When they're cruel, I (used to) feel
      obliged to return the favour. I'm passionate about personal freedoms,
      trying new things, enhancing creativity and productivity, and I feel that
      letting yourself get out of your comfort zone is the most valuable skill
      you can obtain.
    </p>
  </AboutSection>

  <AboutSection title="How People See Me">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="users" size={22} /></span
    >
    <p class="text-gray-dark">
      I try to not be rude, but I'm dead honest and the truth can be hurtful.
      Sometimes being that honest is bad, but most of the time it's great.
      Still, I don't like hurting people, so I have no problem being apologetic
      when I see that I hurt somebody's feelings. It's not a sign of weakness,
      even though in certain cultures it's seen as one.
    </p>
  </AboutSection>

  <AboutSection title="Right Now">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="info" size={22} /></span
    >
    <p class="text-gray-dark">
      I'm extremely focused on learning and enhancing my skills. The future is
      bleak and fast-paced. I try to stay on top of the tech game and absorb as
      much information as possible.
    </p>
  </AboutSection>

  <AboutSection
    title="Quirks"
    note="Being weird and loving oneself is a key to a happy life, no?"
  >
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="star" size={22} /></span
    >
    <QuirksList quirks={quirks} />
  </AboutSection>

  <AboutSection title="Get in touch" class="mb-12">
    <span slot="icon" class="inline-flex text-accent"
      ><LucideIcon icon="message-square" size={22} /></span
    >
    <ContactCTA inline />
  </AboutSection>
</PageLayout>
